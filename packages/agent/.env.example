# Oxylabs Web Scraper API credentials (NOT AI Studio API key)
# Create an API user under Web Scraper API → Users in the Oxylabs dashboard.
# Quote the password if it contains +, #, spaces, etc.
OXYLABS_USERNAME=
OXYLABS_PASSWORD=

# HTTP bind
AGENT_HOST=127.0.0.1
AGENT_PORT=8787

# Persist digests/policy under this directory (created automatically)
AGENT_DATA_DIR=.data
